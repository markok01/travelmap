# Better Auth
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# Aiven MySQL
MYSQL_HOST=mysql-xxxxx.a.aivencloud.com
MYSQL_PORT=28711
MYSQL_USER=avnadmin
MYSQL_PASSWORD=
MYSQL_DATABASE=travelmap

MYSQL_SSL=true
MYSQL_SSL_REJECT_UNAUTHORIZED=false
# Optional: path to Aiven CA cert (local only — do NOT set this on Vercel)
# MYSQL_SSL_CA=./certs/ca.pem

# Email (password reset + change notifications)
# Without RESEND_API_KEY, reset links are printed in the server console (dev).
RESEND_API_KEY=
EMAIL_FROM=Family Travel Atlas <onboarding@resend.dev>
